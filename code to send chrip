"""
Send a chirp and record it with the same NI USB-6366, then plot what came back.
 
Use it to see the signal before doing a TVR measurement:
  - the raw transmitted and received waveforms,
  - a spectrogram of the received signal,
  - the matched-filter (pulse-compressed) output, which shows each arrival
    (direct path, reflections) as a sharp peak at its travel time,
  - the received spectrum relative to the transmitted one.
 
First test: wire ao0 straight to ai0 with a BNC cable ("loopback").
You should see one clean peak at time 0. Then connect the amplifier,
projector and hydrophone.
 
Set SIMULATE = True to try it without hardware.
"""
import numpy as np
import matplotlib.pyplot as plt
from scipy.signal import chirp, correlate, spectrogram, hilbert, find_peaks
from scipy.signal.windows import tukey
 
# ======================= SETUP: EDIT THESE ===========================
SIMULATE  = True          # True: synthetic data, no hardware needed
 
DEVICE    = "Dev1"        # name shown in NI MAX
AO_CHAN   = "ao0"         # output (to amplifier, or looped back to ai0)
AI_CHAN   = "ai0"         # input (hydrophone, or the loopback cable)
FS        = 2_000_000     # sample rate (S/s). USB-6366 AI max is 2 MS/s per channel
 
F0, F1    = 10_000, 100_000   # chirp start and end frequency (Hz)
T_CHIRP   = 2e-3              # chirp length (s)
AMPL      = 0.5               # output amplitude (V peak). AO range is +-10 V
T_LISTEN  = 10e-3             # how long to keep recording after the chirp ends (s)
N_AVG     = 4                 # number of pings averaged (reduces noise)
 
AI_RANGE  = 5.0               # input range (+-V). Pick the smallest that fits the signal
C_WATER   = 1482.0            # sound speed (m/s), only used to label distances
# =====================================================================
 
 
def make_chirp():
    t = np.arange(int(T_CHIRP * FS)) / FS
    x = AMPL * chirp(t, f0=F0, t1=T_CHIRP, f1=F1, method="linear")
    x *= tukey(len(x), 0.1)          # soft edges stop the output from ringing
    n_total = len(x) + int(T_LISTEN * FS)
    tx = np.zeros(n_total)
    tx[:len(x)] = x
    return tx, x
 
 
def play_record(tx):
    """Play tx on AO and record AI on the same sample clock."""
    if SIMULATE:
        return simulate(tx)
    import nidaqmx
    from nidaqmx.constants import AcquisitionType, TerminalConfiguration
    n = len(tx)
    with nidaqmx.Task() as ai, nidaqmx.Task() as ao:
        ai.ai_channels.add_ai_voltage_chan(
            f"{DEVICE}/{AI_CHAN}", min_val=-AI_RANGE, max_val=AI_RANGE,
            terminal_config=TerminalConfiguration.DIFF)
        ai.timing.cfg_samp_clk_timing(FS, sample_mode=AcquisitionType.FINITE,
                                      samps_per_chan=n)
        ao.ao_channels.add_ao_voltage_chan(f"{DEVICE}/{AO_CHAN}",
                                           min_val=-10, max_val=10)
        # AO steps on the AI sample clock, so sample k of the output and
        # sample k of the input happen at the same instant
        ao.timing.cfg_samp_clk_timing(FS, source=f"/{DEVICE}/ai/SampleClock",
                                      sample_mode=AcquisitionType.FINITE,
                                      samps_per_chan=n)
        ao.write(tx, auto_start=False)
        ao.start()                  # armed, waiting for the AI clock
        ai.start()
        rx = np.array(ai.read(number_of_samples_per_channel=n, timeout=10 + n / FS))
        ao.wait_until_done(timeout=10 + n / FS)
        ao.write(np.zeros(2), auto_start=True)   # leave the output at 0 V
    return rx
 
 
def simulate(tx):
    """Fake tank: direct path at 0.7 ms, two weaker reflections, noise."""
    rng = np.random.default_rng()
    rx = np.zeros_like(tx)
    for delay, gain in [(0.70e-3, 0.02), (1.50e-3, 0.008), (2.6e-3, 0.004)]:
        d = int(delay * FS)
        rx[d:] += gain * tx[:len(tx) - d]
    return rx + rng.normal(0, 2e-3, len(rx))
 
 
def main():
    tx, ref = make_chirp()
    rx = np.mean([play_record(tx) for _ in range(N_AVG)], axis=0)
    t = np.arange(len(tx)) / FS
 
    # matched filter: correlate the recording with the transmitted chirp
    mf = correlate(rx, ref, mode="full")[len(ref) - 1:]       # lag 0 = start of recording
    env = np.abs(hilbert(mf))
    env_db = 20 * np.log10(env / env.max() + 1e-12)
    pk, _ = find_peaks(env_db, height=-30, prominence=10, distance=int(0.1e-3 * FS))
    print("Arrivals (matched-filter peaks):")
    for p in pk[np.argsort(env_db[pk])[::-1]][:8]:
        print(f"  {t[p]*1e3:7.3f} ms   {env_db[p]:6.1f} dB   "
              f"(path length {t[p]*C_WATER:5.2f} m)")
 
    # received spectrum relative to transmitted
    nfft = 1 << int(np.ceil(np.log2(len(tx))))
    f = np.fft.rfftfreq(nfft, 1 / FS)
    TX = np.fft.rfft(tx, nfft); RX = np.fft.rfft(rx, nfft)
    band = (f >= F0) & (f <= F1)
    H_db = 20 * np.log10(np.abs(RX[band]) / np.abs(TX[band]) + 1e-15)
 
    fig, ax = plt.subplots(2, 2, figsize=(12, 7))
    a = ax[0, 0]
    a.plot(t * 1e3, tx, color="0.6", lw=0.6, label="sent (ao)")
    a.plot(t * 1e3, rx / (np.abs(rx).max() + 1e-15) * np.abs(tx).max(),
           color="C0", lw=0.6, label="received (ai), scaled")
    a.set_xlabel("Time (ms)"); a.set_ylabel("Voltage (V)")
    a.set_title("Raw waveforms"); a.legend(fontsize=8)
 
    a = ax[0, 1]
    fs_, ts_, S = spectrogram(rx, FS, nperseg=512, noverlap=480, nfft=1024)
    Sdb = 10 * np.log10(S + 1e-20)
    a.pcolormesh(ts_ * 1e3, fs_ / 1e3, Sdb, vmin=Sdb.max() - 50, vmax=Sdb.max(),
                 shading="auto")
    a.set_ylim(0, min(FS / 2, 1.5 * F1) / 1e3)
    a.set_xlabel("Time (ms)"); a.set_ylabel("Frequency (kHz)")
    a.set_title("Received spectrogram")
 
    a = ax[1, 0]
    a.plot(t * 1e3, env_db, "k", lw=0.8)
    a.plot(t[pk] * 1e3, env_db[pk], "rv")
    a.set_ylim(-60, 3); a.set_xlim(0, (T_CHIRP + T_LISTEN) * 1e3)
    a.set_xlabel("Travel time (ms)"); a.set_ylabel("dB re max")
    a.set_title("Matched-filter output: one peak per arrival")
    sec = a.secondary_xaxis("top", functions=(lambda x: x * 1e-3 * C_WATER,
                                              lambda d: d / C_WATER * 1e3))
    sec.set_xlabel("Path length (m)")
 
    a = ax[1, 1]
    a.plot(f[band] / 1e3, H_db, "C0", lw=0.8)
    a.set_xlabel("Frequency (kHz)"); a.set_ylabel("dB")
    a.set_title("Received / sent spectrum\n(ripple = interference between arrivals)")
 
    for a in ax.ravel():
        a.grid(alpha=0.3)
    fig.tight_layout()
    fig.savefig("chirp_test.png", dpi=150)
    np.savez("chirp_test.npz", t=t, tx=tx, rx=rx, fs=FS)
    print("Saved chirp_test.png and chirp_test.npz")
    plt.show()
 
 
if __name__ == "__main__":
    main()
 